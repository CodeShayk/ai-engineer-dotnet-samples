<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Section 16.3: timeouts, retries, circuit breakers and fallbacks around model calls with
    Microsoft.Extensions.Resilience (Polly). The demo uses fake clients that fail on cue, so it is
    deterministic and needs no model. The capstone in 16.2 reuses these classes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ch16.Resilience</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Northwind.Shared\Northwind.Shared.csproj" />
  </ItemGroup>

</Project>
