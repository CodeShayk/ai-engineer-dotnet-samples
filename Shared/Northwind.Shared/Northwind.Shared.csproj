<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared building blocks used by the samples from Chapter 2 onward:
      AI/         provider configuration and client factory (Chapter 4.7), prompts, structured output (Chapter 5)
      Domain/     the Northwind Traders customers, products, orders and business rules
      Tools/      order and refund tools (Chapter 6), reused by later chapters
      Knowledge/  the policy library and retrieval pipeline (Chapter 9), reused by later chapters
      Security/   redaction, prompt attack screening and output sanitization (Chapters 10, 13 and 16)
      Testing/    a fake IChatClient for unit tests (Chapter 4.7)
  -->
  <PropertyGroup>
    <RootNamespace>Northwind.Shared</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
    <PackageReference Include="CommunityToolkit.VectorData.InMemory" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="OllamaSharp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Knowledge\Policies\*.md" LogicalName="Policies/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
